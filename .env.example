# ==============================================================================
# SHE-VALLEY — Environment Configuration Template
# Never commit real secrets or credentials. Copy to .env.local for local dev.
# ==============================================================================

# --- AI Studio / Platform Runtime ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Application Environment ---
NODE_ENV="development"
VITE_APP_NAME="SHE-VALLEY"
VITE_DEFAULT_LOCALE="en"
VITE_SUPPORTED_LOCALES="en,bn"
VITE_CURRENCY="BDT"

# --- Cloud SQL (PostgreSQL) Runtime Variables (server-side only) ---
# Provisioned automatically by AI Studio Cloud SQL integration
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# --- Authentication & Session Security (server-side only) ---
AUTH_SECRET="replace-with-32-plus-char-random-secret"

# --- Command 03 External Provider Credentials (server-side only; optional) ---
# Integrations stay in PENDING_CREDENTIALS / SANDBOX mode until real credentials are provided.
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-hmac-secret"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_PRIVATE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWD=""

COURIER_WEBHOOK_SECRET="replace-with-courier-webhook-secret"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
REDX_API_TOKEN=""

META_APP_SECRET=""
META_VERIFY_TOKEN="shevalley-meta-verify"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
META_CAPI_ACCESS_TOKEN=""
META_PIXEL_ID=""

N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET="replace-with-n8n-hmac-secret"
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMS_API_KEY=""

